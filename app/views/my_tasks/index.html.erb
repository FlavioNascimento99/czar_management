<% content_for :title, "Minhas Tarefas" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Minhas Tarefas</h1>
    <small class="text-muted">Tudo atribuído a você, ordenado por prazo</small>
  </div>
  <div class="d-flex gap-2 align-items-center">
    <%= link_to "Calendário (.ics)", my_tasks_calendar_path(format: :ics), class: "btn btn-sm btn-outline-info" %>
    <% if @overdue_count.positive? %>
      <span class="badge bg-danger fs-6"><%= @overdue_count %> atrasada(s)</span>
    <% end %>
  </div>
</div>

<div class="d-flex gap-2 mb-3 flex-wrap">
  <%= link_to "Todas", my_tasks_path, class: "btn btn-sm #{params[:filter].blank? && params[:status].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>
  <%= link_to "Abertas", my_tasks_path(filter: "open"), class: "btn btn-sm #{params[:filter] == 'open' ? 'btn-primary' : 'btn-outline-primary'}" %>
  <%= link_to "Atrasadas", my_tasks_path(filter: "overdue"), class: "btn btn-sm #{params[:filter] == 'overdue' ? 'btn-danger' : 'btn-outline-danger'}" %>
  <%= link_to "Vencem hoje", my_tasks_path(filter: "today"), class: "btn btn-sm #{params[:filter] == 'today' ? 'btn-warning' : 'btn-outline-warning'}" %>
</div>

<% if @tasks.any? %>
  <div class="list-group">
    <% @tasks.each do |task| %>
      <%= link_to project_task_path(task.project, task), class: "list-group-item list-group-item-action" do %>
        <div class="d-flex justify-content-between align-items-center gap-2">
          <div>
            <strong><%= task.title %></strong>
            <small class="text-muted d-block"><%= task.project.name %> · <%= task.status.humanize %></small>
          </div>
          <%= due_date_badge(task) %>
        </div>
      <% end %>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center">
    <%= paginate @tasks, theme: "bootstrap-5" %>
  </div>
<% else %>
  <p class="text-muted">Nenhuma tarefa atribuída a você aqui. 🎉</p>
<% end %>
