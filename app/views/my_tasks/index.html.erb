<% content_for :title, "My Tasks — Czar" %>

<div class="saas-page-head">
  <div>
    <h1>My Tasks</h1>
    <p>Everything assigned to you, ordered by due date.</p>
  </div>
  <div class="saas-page-actions">
    <% if @overdue_count.positive? %>
      <span class="saas-badge red"><%= @overdue_count %> overdue</span>
    <% end %>
    <%= link_to my_tasks_calendar_path(format: :ics), class: "saas-btn saas-btn-ghost saas-btn-sm" do %>
      <%= icon("calendar") %><span>Calendar (.ics)</span>
    <% end %>
  </div>
</div>

<nav class="saas-seg" aria-label="Filter tasks">
  <%= link_to "All", my_tasks_path, class: "saas-seg-item",
              aria: { current: ("page" if params[:filter].blank? && params[:status].blank?) } %>
  <%= link_to "Open", my_tasks_path(filter: "open"), class: "saas-seg-item",
              aria: { current: ("page" if params[:filter] == "open") } %>
  <%= link_to "Overdue", my_tasks_path(filter: "overdue"), class: "saas-seg-item danger",
              aria: { current: ("page" if params[:filter] == "overdue") } %>
  <%= link_to "Due today", my_tasks_path(filter: "today"), class: "saas-seg-item",
              aria: { current: ("page" if params[:filter] == "today") } %>
</nav>

<% if @tasks.any? %>
  <div class="saas-list">
    <% @tasks.each do |task| %>
      <%= link_to project_task_path(task.project, task), class: "saas-list-item" do %>
        <span class="saas-list-main">
          <span class="saas-list-title"><%= task.title %></span>
          <span class="saas-row-meta"><%= task.project.name %> · <%= task.status.humanize %></span>
        </span>
        <%= due_date_badge(task) %>
      <% end %>
    <% end %>
  </div>
  <div class="saas-pager"><%= paginate @tasks, theme: "bootstrap-5" %></div>
<% else %>
  <div class="saas-panel">
    <%= empty_state(icon_name: "list-checks", title: "Nothing assigned to you",
                    text: "When someone assigns you a task in any project, it shows up here with its due date.") do %>
      <%= link_to "Browse projects", projects_path, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <% end %>
  </div>
<% end %>
