<% content_for :title, "Notificações" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Notificações</h1>
  <%= button_to "Marcar todas como lidas", read_all_notifications_path, method: :patch, class: "btn btn-sm btn-outline-primary" %>
</div>

<% unless EmailGate.enabled? %>
  <div class="alert alert-info">E-mail <span class="badge bg-secondary">A implementar</span> — enquanto a conexão externa (SMTP) não existe, todos os avisos chegam aqui no app.</div>
<% end %>

<% if @notifications.any? %>
  <div class="list-group">
    <% @notifications.each do |notification| %>
      <div class="list-group-item d-flex justify-content-between align-items-center <%= 'list-group-item-light' if notification.read? %>">
        <%= link_to notification_link(notification), class: "text-decoration-none #{notification.read? ? 'text-muted' : ''}" do %>
          <span><%= notification_text(notification) %></span>
          <small class="text-muted d-block"><%= l(notification.created_at, format: :short) %></small>
        <% end %>
        <% unless notification.read? %>
          <%= button_to "Ler", read_notification_path(notification), method: :patch, class: "btn btn-sm btn-outline-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center">
    <%= paginate @notifications, theme: "bootstrap-5" %>
  </div>
<% else %>
  <p class="text-muted">Nenhuma notificação. 🎉</p>
<% end %>
