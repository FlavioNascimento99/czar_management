<% content_for :title, "Notifications — Czar" %>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Inbox</span>
    <h1>Notifications</h1>
    <p>All your updates in one calm place.</p>
  </div>
  <%= button_to "Mark all as read", read_all_notifications_path, method: :patch, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
</div>

<% unless EmailGate.enabled? %>
  <div class="saas-panel" style="margin-bottom:14px"><span class="saas-badge gray">Soon</span> <span class="saas-mini">Email is not connected yet (no SMTP) — all alerts arrive here in-app.</span></div>
<% end %>

<% if @notifications.any? %>
  <div class="saas-list">
    <% @notifications.each do |notification| %>
      <div class="saas-list-item" style="<%= 'opacity:.65' if notification.read? %>">
        <%= link_to notification_link(notification), style: "color:inherit" do %>
          <span><%= notification_text(notification) %></span>
          <small class="saas-mini" style="display:block"><%= l(notification.created_at, format: :short) %></small>
        <% end %>
        <% unless notification.read? %>
          <%= button_to "Read", read_notification_path(notification), method: :patch, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center"><%= paginate @notifications, theme: "bootstrap-5" %></div>
<% else %>
  <div class="saas-panel"><div class="saas-empty"><p>No notifications. 🎉</p></div></div>
<% end %>
