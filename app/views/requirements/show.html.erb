<% content_for :title, "#{@requirement.title} — #{@project.name}" %>
<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Requirement</span></nav>
<article class="saas-form-wrap">
  <div class="saas-task-head">
    <h1><%= @requirement.title %></h1>
    <%= priority_badge(@requirement.priority) %>
  </div>
  <hr class="saas-divider">
  <div class="saas-prose-sm"><%= simple_format(@requirement.description) %></div>
  <div class="saas-form-actions">
    <%= link_to edit_project_requirement_path(@project, @requirement), class: "saas-btn saas-btn-primary saas-btn-sm" do %>
      <%= icon("pencil") %><span>Edit</span>
    <% end %>
    <%= link_to [@project, @requirement], data: { turbo_method: :delete, turbo_confirm: "Delete this requirement?" }, class: "saas-btn saas-btn-danger-soft saas-btn-sm" do %>
      <%= icon("trash") %><span>Delete</span>
    <% end %>
    <%= link_to @project, class: "saas-btn saas-btn-ghost saas-btn-sm" do %>
      <%= icon("arrow-left") %><span>Back</span>
    <% end %>
  </div>
</article>
