<% content_for :title, "Editar Requisito - #{@project.name}" %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow">
      <div class="card-header">
        <h3 class="card-title mb-0">Editar Requisito</h3>
        <small class="text-muted">Projeto: <%= @project.name %></small>
      </div>
      <div class="card-body">
        <%= form_with model: [ @project, @requirement ], local: true do |form| %>
          <% if @requirement.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @requirement.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :title, "Título do Requisito", class: "form-label" %>
            <%= form.text_field :title, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :description, "Descrição", class: "form-label" %>
            <%= form.text_area :description, class: "form-control", rows: 4, required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :priority, "Prioridade", class: "form-label" %>
            <%= form.select :priority,
                options_for_select([
                  [ "Baixa", "baixa" ],
                  [ "Média", "media" ],
                  [ "Alta", "alta" ]
                ], @requirement.priority),
                {}, { class: "form-select", required: true } %>
          </div>

          <div class="d-flex gap-2">
            <%= form.submit "Atualizar Requisito", class: "btn btn-primary" %>
            <%= link_to "Cancelar", [ @project, @requirement ], class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
