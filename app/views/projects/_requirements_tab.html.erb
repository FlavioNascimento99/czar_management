<div class="saas-tab-head">
  <h2>Requirements</h2>
  <%= link_to new_project_requirement_path(@project), class: "saas-btn saas-btn-primary saas-btn-sm" do %>
    <%= icon("plus") %><span>New requirement</span>
  <% end %>
</div>

<% if @requirements.any? %>
  <div class="saas-task-grid two">
    <% @requirements.each do |requirement| %>
      <article class="saas-task">
        <div class="saas-task-top">
          <h3><%= link_to requirement.title, [@project, requirement] %></h3>
          <%= priority_badge(requirement.priority) %>
        </div>
        <p><%= truncate(requirement.description, length: 120) %></p>
        <div class="saas-task-foot">
          <%= link_to "Open", [@project, requirement], class: "saas-btn saas-btn-ghost saas-btn-sm" %>
          <%= link_to "Edit", edit_project_requirement_path(@project, requirement), class: "saas-btn saas-btn-subtle saas-btn-sm" %>
        </div>
      </article>
    <% end %>
  </div>
  <div class="saas-pager">
    <%= paginate @requirements, param_name: :requirements_page, theme: "bootstrap-5" %>
  </div>
<% else %>
  <div class="saas-panel">
    <%= empty_state(icon_name: "file-text", title: "No requirements yet",
                    text: "Capture what needs to be built before you build it, then turn requirements into tasks.") do %>
      <%= link_to "Create first requirement", new_project_requirement_path(@project), class: "saas-btn saas-btn-primary saas-btn-sm" %>
    <% end %>
  </div>
<% end %>
