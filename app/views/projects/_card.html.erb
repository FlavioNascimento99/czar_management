<div class="saas-proj">
  <div class="saas-badges">
    <span class="saas-badge <%= project.pessoal? ? 'gray' : 'green' %>"><%= project.pessoal? ? "Personal" : "Team" %></span>
  </div>
  <h3><%= link_to project.name, project %></h3>
  <p><%= truncate(project.description, length: 100) %></p>
  <div class="saas-proj-meta">
    <div><strong><%= task_counts.fetch(project.id, 0) %></strong><small>Tasks</small></div>
    <div><strong><%= requirement_counts.fetch(project.id, 0) %></strong><small>Requirements</small></div>
    <div><strong><%= project.users.size %></strong><small>Members</small></div>
  </div>
  <div class="saas-proj-actions">
    <%= link_to "Open", project, class: "saas-btn saas-btn-primary saas-btn-sm" %>
    <%= link_to "Edit", edit_project_path(project), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
  </div>
</div>
