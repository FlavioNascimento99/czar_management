<% content_for :title, "#{@project.name} — Czar" %>

<%= render "header" %>
<%= render "stats" %>

<div class="saas-2col" style="margin-bottom:0">
  <div>
    <%= render "members" %>
    <%= render "activity" %>
  </div>
  <div class="saas-panel">
    <h2>Linked docs</h2>
    <p class="saas-mini">Knowledge lives in Documents — link task docs from the task page.</p>
    <%= link_to "Open Documents", docs_path, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <%= link_to "＋ New doc", new_doc_path, class: "saas-btn saas-btn-primary saas-btn-sm" %>
  </div>
</div>

<ul class="nav nav-tabs saas-tabs" id="projectTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="tasks-tab" data-bs-toggle="tab" data-bs-target="#tasks" type="button" role="tab">
      Tasks · <%= @tasks_count %>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="requirements-tab" data-bs-toggle="tab" data-bs-target="#requirements" type="button" role="tab">
      Requirements · <%= @requirements_count %>
    </button>
  </li>
</ul>

<div class="tab-content" id="projectTabsContent">
  <div class="tab-pane fade show active saas-tab-body" id="tasks" role="tabpanel">
    <%= render "tasks_tab" %>
  </div>
  <div class="tab-pane fade saas-tab-body" id="requirements" role="tabpanel">
    <%= render "requirements_tab" %>
  </div>
</div>
