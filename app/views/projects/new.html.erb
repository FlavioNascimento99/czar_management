<% content_for :title, "New project — Czar" %>

<div class="saas-crumb"><%= link_to "Dashboard", root_path %> <span class="sep">/</span> <%= link_to "Projects", projects_path %> <span class="sep">/</span> <span>New</span></div>

<div class="saas-form-wrap">
  <span class="saas-section-label">Manage · Project</span>
  <h1>New project</h1>
  <p class="muted">Team space or personal routine. Takes 30 seconds — docs stay in <%= link_to "Documents", docs_path %>.</p>

  <%= form_with model: @project, local: true do |form| %>
    <% if @project.errors.any? %>
      <div class="saas-errors">
        <ul style="margin:0;padding-left:18px">
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="saas-field">
      <%= form.label :name, "Project name" %>
      <%= form.text_field :name, required: true, placeholder: "Ex: Website redesign",
                          style: "width:100%;border:1px solid var(--sz-line);border-radius:10px;padding:11px 12px;font-size:14px" %>
    </div>

    <div class="saas-field">
      <%= form.label :description, "Description" %>
      <%= form.text_area :description, rows: 4, required: true, placeholder: "Goals and scope…" %>
    </div>

    <div class="saas-field-row two">
      <div class="saas-field">
        <%= form.label :kind, "Space type" %>
        <%= form.select :kind, options_for_select([["Team", "equipe"], ["Personal (routine, studies)", "pessoal"]]) %>
        <div class="saas-mini" style="margin-top:6px">Personal allows only you as member.</div>
      </div>
      <div class="saas-field">
        <%= form.label :template, "Start from template (optional)" %>
        <%= form.select :template, options_for_select([["Blank project", ""]] + ProjectTemplateService::TEMPLATES.map { |k, v| [v[:name], k] }) %>
      </div>
    </div>

    <div class="saas-form-actions">
      <%= form.submit "Create project", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", projects_path, class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
