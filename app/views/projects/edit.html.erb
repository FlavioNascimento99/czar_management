<% content_for :title, "Edit #{@project.name} — Czar" %>

<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Edit</span></nav>

<div class="saas-form-wrap">
  <h1>Edit project</h1>
  <p class="muted">Rename, clarify the goal, or switch between team and personal space.</p>

  <%= form_with model: @project, local: true do |form| %>
    <%= render "shared/form_errors", record: @project %>

    <div class="saas-field">
      <%= form.label :name, "Project name" %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="saas-field">
      <%= form.label :description, "Description" %>
      <%= form.text_area :description, rows: 4, required: true %>
    </div>

    <div class="saas-field">
      <%= form.label :kind, "Space type" %>
      <%= form.select :kind, options_for_select([["Team", "equipe"], ["Personal (routine, studies)", "pessoal"]], @project.kind), {}, aria: { describedby: "project_kind_hint" } %>
      <span class="saas-hint" id="project_kind_hint">Personal allows only you as member.</span>
    </div>

    <div class="saas-form-actions">
      <%= form.submit "Save changes", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", @project, class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
