<% content_for :title, "Edit #{@project.name} — Czar" %>

<div class="saas-crumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Edit</span></div>

<div class="saas-form-wrap">
  <span class="saas-section-label">Manage · Project settings</span>
  <h1>Edit project</h1>
  <p class="muted">Rename, clarify the goal, or switch between team and personal space.</p>

  <%= form_with model: @project, local: true do |form| %>
    <% if @project.errors.any? %>
      <div class="saas-errors">
        <ul style="margin:0;padding-left:18px">
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="saas-field">
      <%= form.label :name, "Project name" %>
      <%= form.text_field :name, required: true, style: "width:100%;border:1px solid var(--sz-line);border-radius:10px;padding:11px 12px;font-size:14px" %>
    </div>

    <div class="saas-field">
      <%= form.label :description, "Description" %>
      <%= form.text_area :description, rows: 4, required: true %>
    </div>

    <div class="saas-field">
      <%= form.label :kind, "Space type" %>
      <%= form.select :kind, options_for_select([["Team", "equipe"], ["Personal (routine, studies)", "pessoal"]], @project.kind) %>
      <div class="saas-mini" style="margin-top:6px">Personal allows only you as member.</div>
    </div>

    <div class="saas-form-actions">
      <%= form.submit "Save changes", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", @project, class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
