<div class="saas-crumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <span><%= @project.name %></span></div>

<div class="saas-page-head">
  <div>
    <div class="saas-badges" style="margin-bottom:8px">
      <span class="saas-section-label">Manage · Project</span>
      <span class="saas-badge <%= @project.pessoal? ? 'gray' : 'green' %>"><%= @project.pessoal? ? "Personal" : "Team" %></span>
    </div>
    <h1><%= @project.name %></h1>
    <p><%= @project.description %></p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <%= link_to "Kanban", board_project_path(@project), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <%= link_to "Calendar", calendar_project_path(@project, format: :ics), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <%= link_to "Edit", edit_project_path(@project), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <% if @project.owned_by?(current_user) %>
      <%= link_to "Delete", @project,
                  data: { turbo_method: :delete, turbo_confirm: "Delete this project? This cannot be undone." },
                  class: "saas-btn saas-btn-ghost saas-btn-sm", style: "color:var(--sz-red);border-color:#fecaca" %>
    <% end %>
  </div>
</div>
