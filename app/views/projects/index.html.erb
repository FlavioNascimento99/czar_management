<% content_for :title, "Projects — Czar" %>

<div class="saas-page-head">
  <div>
    <h1>Projects</h1>
    <p>All the projects you belong to. Create one to get started.</p>
  </div>
  <%= link_to "＋ New project", new_project_path, class: "saas-btn saas-btn-primary" %>
</div>

<% if @projects.any? %>
  <h4 class="mt-4">Equipes (<%= @team_projects.size %>)</h4>
  <div class="row">
    <% @team_projects.each do |project| %>
      <%= render "card", project: project, task_counts: @task_counts, requirement_counts: @requirement_counts %>
    <% end %>
  </div>

  <h4 class="mt-4">Pessoal — rotinas e estudos (<%= @personal_projects.size %>)</h4>
  <div class="row">
    <% @personal_projects.each do |project| %>
      <%= render "card", project: project, task_counts: @task_counts, requirement_counts: @requirement_counts %>
    <% end %>
  </div>
  <% if @personal_projects.empty? %>
    <p class="text-muted">Crie um espaço pessoal com o modelo "Rotina de estudos". 🌱</p>
  <% end %>
<% else %>
  <div class="text-center py-5">
    <div class="mb-4">
      <svg width="64" height="64" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
        <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
      </svg>
    </div>
    <h4 class="text-muted">No projects yet</h4>
    <p class="text-muted">Create your first project — free, and ready in 30 seconds.</p>
    <%= link_to "Create project", new_project_path, class: "saas-btn saas-btn-primary" %>
  </div>
<% end %>
