<% content_for :title, "Projects — Czar" %>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Manage · Projects</span>
    <h1>Projects</h1>
    <p>Team spaces and personal routines. Docs live in <%= link_to "Documents", docs_path %> — projects are for execution.</p>
  </div>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
    <%= link_to "＋ New doc", new_doc_path, class: "saas-btn saas-btn-ghost" %>
    <%= link_to "＋ New project", new_project_path, class: "saas-btn saas-btn-primary" %>
  </div>
</div>

<% if @projects.any? %>
  <div class="saas-panel" style="margin-bottom:16px">
    <h2>Team projects · <%= @team_projects.size %></h2>
    <% if @team_projects.any? %>
      <div class="saas-grid" style="margin-top:12px">
        <% @team_projects.each do |project| %>
          <%= render "card", project: project, task_counts: @task_counts, requirement_counts: @requirement_counts %>
        <% end %>
      </div>
    <% else %>
      <div class="saas-empty"><p>No team projects yet.</p></div>
    <% end %>
  </div>

  <div class="saas-panel">
    <h2>Personal — routines & studies · <%= @personal_projects.size %></h2>
    <% if @personal_projects.any? %>
      <div class="saas-grid" style="margin-top:12px">
        <% @personal_projects.each do |project| %>
          <%= render "card", project: project, task_counts: @task_counts, requirement_counts: @requirement_counts %>
        <% end %>
      </div>
    <% else %>
      <div class="saas-empty">
        <p>Create a personal space with the "Study routine" template. 🌱</p>
        <%= link_to "New personal project", new_project_path, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="saas-panel">
    <div class="saas-empty">
      <p><strong>No projects yet.</strong><br>Create your first project — free, and ready in 30 seconds.</p>
      <%= link_to "Create project", new_project_path, class: "saas-btn saas-btn-primary saas-btn-sm" %>
    </div>
  </div>
<% end %>
