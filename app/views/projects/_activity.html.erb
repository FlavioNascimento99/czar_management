<section class="saas-panel">
  <h2>Recent activity</h2>
  <% if @activities.any? %>
    <div class="saas-side-list">
      <% @activities.each do |log| %>
        <div class="saas-row">
          <span><%= activity_description(log) %></span>
          <small class="saas-mini"><%= l(log.created_at, format: :short) %></small>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(icon_name: "inbox", title: "No activity yet",
                    text: "Creating tasks, comments and requirements will show up here.") %>
  <% end %>
</section>
