<div class="saas-panel" style="margin-bottom:16px">
  <h2>Recent activity</h2>
  <% if @activities.any? %>
    <div>
      <% @activities.each do |log| %>
        <div class="saas-row">
          <span><%= activity_description(log) %></span>
          <small style="color:var(--sz-muted)"><%= l(log.created_at, format: :short) %></small>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="saas-empty"><p>No activity yet. Create a task or requirement!</p></div>
  <% end %>
</div>
