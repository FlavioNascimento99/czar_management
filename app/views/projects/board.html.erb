<% content_for :title, "Kanban — #{@project.name}" %>

<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Kanban</span></nav>

<div class="saas-page-head">
  <div>
    <h1>Kanban</h1>
    <p><%= @project.name %> · Drag a card or use Move to change its status.</p>
  </div>
  <div class="saas-page-actions">
    <%= link_to "Tasks", project_tasks_path(@project), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <%= link_to @project, class: "saas-btn saas-btn-ghost saas-btn-sm" do %>
      <%= icon("arrow-left") %><span>Back to project</span>
    <% end %>
  </div>
</div>

<div class="saas-kanban" data-controller="kanban" data-update-base="<%= project_tasks_path(@project) %>">
  <% [["pendente", "Pending"], ["em_andamento", "In Progress"], ["concluida", "Done"]].each do |status, label| %>
    <section class="saas-kanban-col" aria-label="<%= label %>">
      <div class="saas-kanban-head"><span><%= label %></span><span class="saas-badge gray"><%= @columns[status].size %></span></div>
      <div class="saas-kanban-body" data-status="<%= status %>" data-kanban-target="column" data-action="dragover->kanban#dragOver drop->kanban#drop">
        <div data-cards>
          <% @columns[status].each do |task| %>
            <div class="saas-kanban-card" draggable="true" data-task-id="<%= task.id %>" data-action="dragstart->kanban#dragStart">
              <%= link_to task.title, [@project, task], class: "saas-kanban-title" %>
              <small class="saas-mini"><%= task.assigned_to.name %></small>
              <div class="saas-badges">
                <%= due_date_badge(task) %>
                <% task.tags.each do |tag| %><%= tag_badge(tag) %><% end %>
              </div>
              <%= form_with url: project_task_path(@project, task), method: :patch, local: true, class: "saas-kanban-move" do %>
                <%= select_tag "task[status]", options_for_select([["Pending", "pendente"], ["In Progress", "em_andamento"], ["Done", "concluida"]], task.status),
                               class: "saas-control saas-control-sm", aria: { label: "Status for #{task.title}" } %>
                <%= submit_tag "Move", class: "saas-btn saas-btn-ghost saas-btn-sm" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>
