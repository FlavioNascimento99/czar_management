<% content_for :title, "Kanban - #{@project.name}" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Kanban</h1>
    <small class="text-muted">Projeto: <%= @project.name %> — arraste para mudar o status</small>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Tarefas", project_tasks_path(@project), class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Voltar ao projeto", @project, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div class="row" data-controller="kanban" data-update-base="<%= project_tasks_path(@project) %>">
  <% [["pendente", "Pendente", "secondary"], ["em_andamento", "Em Andamento", "warning"], ["concluida", "Concluída", "success"]].each do |status, label, color| %>
    <div class="col-md-4">
      <div class="card mb-3">
        <div class="card-header bg-<%= color %> <%= color == "warning" ? "text-dark" : "text-white" %> fw-bold">
          <%= label %> (<%= @columns[status].size %>)
        </div>
        <div class="card-body" data-status="<%= status %>" data-kanban-target="column" data-action="dragover->kanban#dragOver drop->kanban#drop">
          <div data-cards>
            <% @columns[status].each do |task| %>
              <div class="card mb-2" draggable="true" data-task-id="<%= task.id %>" data-action="dragstart->kanban#dragStart">
                <div class="card-body p-2">
                  <%= link_to task.title, [@project, task], class: "fw-bold text-decoration-none" %>
                  <small class="text-muted d-block"><%= task.assigned_to.name %></small>
                  <div class="mt-1 d-flex gap-1 flex-wrap">
                    <%= due_date_badge(task) %>
                    <% task.tags.each do |tag| %>
                      <span class="badge" style="background-color: <%= tag.color %>"><%= tag.name %></span>
                    <% end %>
                  </div>
                  <%= form_with url: project_task_path(@project, task), method: :patch, local: true, class: "mt-2 d-flex gap-1" do %>
                    <%= hidden_field_tag "task[status]", status %>
                    <%= select_tag "task[status]", options_for_select([["Pendente", "pendente"], ["Em Andamento", "em_andamento"], ["Concluída", "concluida"]], task.status), class: "form-select form-select-sm" %>
                    <%= submit_tag "Mover", class: "btn btn-sm btn-outline-primary" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
