<% content_for :title, "Start free — Czar" %>

<div class="saas-auth">
  <span class="saas-logo" aria-hidden="true">C</span>
  <h1>Start free</h1>
  <p class="muted">Free forever for small teams. No credit card. Set up in 30 seconds.</p>

  <%= form_with model: @user, url: signup_path, local: true do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div class="saas-field">
      <%= form.label :name, "Your name" %>
      <%= form.text_field :name, required: true, placeholder: "Ada Lovelace", autocomplete: "name" %>
    </div>
    <div class="saas-field">
      <%= form.label :email, "Work email" %>
      <%= form.email_field :email, required: true, placeholder: "you@team.com", autocomplete: "email" %>
    </div>
    <div class="saas-field">
      <%= form.label :password, "Password (min. 8 characters)" %>
      <%= form.password_field :password, required: true, minlength: 8, placeholder: "••••••••", autocomplete: "new-password" %>
    </div>
    <div class="saas-field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, placeholder: "••••••••", autocomplete: "new-password" %>
    </div>
    <%= form.submit "Create free account", class: "saas-btn saas-btn-primary saas-btn-lg full" %>
  <% end %>

  <p class="saas-auth-foot">
    Already have an account? <%= link_to "Log in", login_path %>
  </p>
</div>
