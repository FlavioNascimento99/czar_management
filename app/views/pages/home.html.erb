<% if logged_in? %>
  <% content_for :title, "Dashboard — CZAR MANAGER" %>

  <div class="saas-page-head">
    <div>
      <h1>Good to see you, <%= current_user.name.split.first %></h1>
      <p>Here's what's happening across your projects today.</p>
    </div>
    <div class="saas-page-actions">
      <%= link_to "View projects", projects_path, class: "saas-btn saas-btn-ghost" %>
      <%= link_to new_project_path, class: "saas-btn saas-btn-primary" do %>
        <%= icon("plus") %><span>New project</span>
      <% end %>
    </div>
  </div>

  <div class="saas-stats">
    <div class="saas-stat"><span>Active projects</span><strong><%= @projects_count %></strong></div>
    <div class="saas-stat"><span>Tasks assigned to you</span><strong><%= @assigned_count %></strong></div>
    <div class="saas-stat"><span>In progress</span><strong><%= @doing_count %></strong></div>
    <div class="saas-stat"><span>Completed</span><strong><%= @done_count %></strong></div>
  </div>

  <div class="saas-2col">
    <section class="saas-panel">
      <div class="saas-panel-head">
        <h2>Recent projects</h2>
        <% if @projects.any? %><%= link_to "View all", projects_path, class: "saas-btn saas-btn-subtle saas-btn-sm" %><% end %>
      </div>
      <% if @projects.any? %>
        <div class="saas-side-list">
          <% @projects.each do |project| %>
            <div class="saas-row">
              <div class="saas-row-main">
                <%= link_to project.name, project %>
                <span class="saas-row-meta"><%= truncate(project.description, length: 80) %></span>
              </div>
              <%= link_to "Open", project, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= empty_state(icon_name: "folder-kanban", title: "No projects yet", text: "Create your first project to start assigning tasks. It takes 30 seconds.") do %>
          <%= link_to "Create project", new_project_path, class: "saas-btn saas-btn-primary saas-btn-sm" %>
        <% end %>
      <% end %>
    </section>

    <section class="saas-panel">
      <div class="saas-panel-head">
        <h2>My tasks</h2>
        <% if @my_tasks.any? %><%= link_to "View all", my_tasks_path, class: "saas-btn saas-btn-subtle saas-btn-sm" %><% end %>
      </div>
      <% if @my_tasks.any? %>
        <div class="saas-side-list">
          <% @my_tasks.each do |task| %>
            <div class="saas-row">
              <div class="saas-row-main">
                <%= link_to task.title, [task.project, task] %>
                <span class="saas-row-meta"><%= task.project.name %></span>
              </div>
              <%= status_badge(task.status) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= empty_state(icon_name: "list-checks", title: "Nothing assigned to you",
                        text: "Tasks assigned to you in any project show up here, newest first.") %>
      <% end %>
    </section>
  </div>

<% else %>
  <% content_for :title, "CZAR MANAGER — Free & easy project management" %>
  <%= render "pages/landing" %>
<% end %>
