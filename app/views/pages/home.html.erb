<% if logged_in? %>
  <% content_for :title, "Dashboard — CZAR MANAGER" %>

  <div class="saas-page-head">
    <div>
      <h1>Good to see you, <%= current_user.name.split.first %> 👋</h1>
      <p>Here's what's happening across your projects today.</p>
    </div>
    <div style="display:flex;gap:10px">
      <%= link_to "View projects", projects_path, class: "saas-btn saas-btn-ghost" %>
      <%= link_to "New project", new_project_path, class: "saas-btn saas-btn-primary" %>
    </div>
  </div>

  <div class="saas-stats">
    <div class="saas-stat"><strong><%= @projects_count %></strong><span>Active projects</span></div>
    <div class="saas-stat"><strong><%= @assigned_count %></strong><span>Tasks assigned to you</span></div>
    <div class="saas-stat"><strong><%= @doing_count %></strong><span>In progress</span></div>
    <div class="saas-stat"><strong><%= @done_count %></strong><span>Completed</span></div>
  </div>

  <div class="saas-2col">
    <div class="saas-panel">
      <h2>Recent projects</h2>
      <% if @projects.any? %>
        <% @projects.each do |project| %>
          <div class="saas-row">
            <span><strong><%= link_to project.name, project %></strong><br><small style="color:var(--sz-muted)"><%= truncate(project.description, length: 80) %></small></span>
            <%= link_to "Open", project, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
          </div>
        <% end %>
      <% else %>
        <div class="saas-empty">
          <p>No projects yet. Create your first one — it takes 30 seconds.</p>
          <%= link_to "Create project", new_project_path, class: "saas-btn saas-btn-primary saas-btn-sm" %>
        </div>
      <% end %>
    </div>

    <div class="saas-panel">
      <h2>My tasks</h2>
      <% if @my_tasks.any? %>
        <% @my_tasks.each do |task| %>
          <div class="saas-row">
            <span><strong><%= link_to task.title, [task.project, task] %></strong><br><small style="color:var(--sz-muted)"><%= task.project.name %></small></span>
            <span class="saas-badge <%= task.status == 'concluida' ? 'green' : task.status == 'em_andamento' ? 'amber' : 'gray' %>"><%= task.status.humanize %></span>
          </div>
        <% end %>
      <% else %>
        <div class="saas-empty"><p>Nothing assigned to you. Enjoy the calm 🎉</p></div>
      <% end %>
    </div>
  </div>

<% else %>
  <% content_for :title, "CZAR MANAGER — Free & easy project management" %>

  <section class="saas-hero">
    <span class="saas-pill">✨ Free forever · No credit card · 30-second setup</span>
    <h1>Project management<br>that's actually easy.</h1>
    <p class="lead">CZAR MANAGER brings your projects, tasks and requirements into one calm place. Invite your team, assign work, and ship — free for small teams.</p>
    <div class="saas-hero-cta">
      <%= link_to "Start free — no card required", signup_path, class: "saas-btn saas-btn-primary" %>
      <%= link_to "Log in", login_path, class: "saas-btn saas-btn-ghost" %>
    </div>
    <p class="saas-proof">Loved by tiny teams · Unlimited projects · Cancel anytime (it's free anyway)</p>

    <div class="saas-mock" aria-hidden="true">
      <div class="saas-mock-bar"><span class="saas-dot"></span><span class="saas-dot"></span><span class="saas-dot"></span></div>
      <div class="saas-mock-body">
        <div class="saas-mock-side"><div></div><div></div><div></div><div></div><div></div></div>
        <div class="saas-mock-main">
          <div class="saas-kpis">
            <div class="saas-kpi"><strong>12</strong><span>Tasks</span></div>
            <div class="saas-kpi"><strong>8</strong><span>Done</span></div>
            <div class="saas-kpi"><strong>3</strong><span>Doing</span></div>
            <div class="saas-kpi"><strong>5</strong><span>Members</span></div>
          </div>
          <div class="saas-bars"><div></div><div></div><div></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="saas-section" id="features">
    <h2>Everything you need, nothing you don't</h2>
    <p class="saas-sub">Built for teams that hate bloated tools.</p>
    <div class="saas-grid-3">
      <div class="saas-card"><div class="saas-icon">📁</div><h3>Projects in seconds</h3><p>Create a project, invite members by email, and start shipping. No setup wizard, no workspace maze.</p></div>
      <div class="saas-card"><div class="saas-icon">✅</div><h3>Tasks with owners</h3><p>Every task has a clear owner, status and priority. Pending → In progress → Done. That's it.</p></div>
      <div class="saas-card"><div class="saas-icon">📝</div><h3>Requirements first</h3><p>Capture what needs to be built before you build it. Prioritize and turn requirements into tasks.</p></div>
      <div class="saas-card"><div class="saas-icon">👥</div><h3>Team-friendly</h3><p>Add members by email, see who's doing what, and leave anytime. Owners stay in control.</p></div>
      <div class="saas-card"><div class="saas-icon">📊</div><h3>Progress at a glance</h3><p>Dashboards show totals, done vs. doing, and your personal to-do list the moment you log in.</p></div>
      <div class="saas-card"><div class="saas-icon">📱</div><h3>Works everywhere</h3><p>Fast, responsive and mobile-ready. Check your tasks from your phone on the go.</p></div>
    </div>
  </section>

  <section class="saas-section" id="how">
    <h2>Get started in 3 steps</h2>
    <p class="saas-sub">From signup to shipped in under a minute.</p>
    <div class="saas-steps">
      <div class="saas-step"><span class="saas-num">1</span><b>Create your free account</b><p>Just name, email and password. No card, no trial countdown.</p></div>
      <div class="saas-step"><span class="saas-num">2</span><b>Start a project &amp; invite the team</b><p>Add members by email and list your first requirements.</p></div>
      <div class="saas-step"><span class="saas-num">3</span><b>Assign tasks &amp; track progress</b><p>Watch work move from pending to done on your dashboard.</p></div>
    </div>
  </section>

  <section class="saas-section" id="pricing">
    <h2>Simple pricing: free.</h2>
    <p class="saas-sub">Yes, really. CZAR MANAGER is free to use while we're growing.</p>
    <div class="saas-pricing">
      <div class="saas-price">
        <h3>Starter</h3>
        <div class="amount">$0</div>
        <p style="opacity:.8">Free forever · for small teams</p>
        <ul>
          <li>✓ Unlimited projects</li>
          <li>✓ Unlimited tasks &amp; requirements</li>
          <li>✓ Team members by email invite</li>
          <li>✓ Dashboard &amp; progress tracking</li>
        </ul>
        <%= link_to "Start free today", signup_path, class: "saas-btn saas-btn-primary", style: "background:#fff;color:#0f172a" %>
      </div>
      <div class="saas-price-note">
        <h3 style="margin-top:0">Why free?</h3>
        <p style="color:var(--sz-muted);font-size:14px">We're focused on making project management effortless. Paid plans with advanced reports and integrations may come later — early users keep free access.</p>
        <ul>
          <li>No credit card required</li>
          <li>Cancel anytime (one click)</li>
          <li>Your data stays yours</li>
        </ul>
        <%= link_to "Talk to us →", signup_path, style: "font-weight:700;color:var(--sz-brand)" %>
      </div>
    </div>
  </section>

  <section class="saas-section" style="text-align:center;padding-bottom:20px">
    <h2>Ready to get organized?</h2>
    <p class="saas-sub">Join CZAR MANAGER today — free, fast, and friendly.</p>
    <%= link_to "Create my free account", signup_path, class: "saas-btn saas-btn-primary" %>
  </section>
<% end %>
