<% content_for :title, "Editar Pasta" %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-body">
        <h3>Editar Pasta</h3>
        <%= form_with model: @folder do |f| %>
          <% if @folder.errors.any? %>
            <div class="alert alert-danger"><ul class="mb-0"><% @folder.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
          <% end %>
          <div class="mb-3">
            <%= f.label :name, "Nome", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :parent_id, "Dentro de", class: "form-label" %>
            <%= f.select :parent_id, options_for_select([["Raiz", ""]] + @folders.map { |x| [x.name, x.id] }, @folder.parent_id), {}, class: "form-select" %>
          </div>
          <div class="d-flex gap-2">
            <%= f.submit "Atualizar", class: "btn btn-primary" %>
            <%= link_to "Cancelar", @folder, class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
