<% content_for :title, (@folder.persisted? ? "Edit folder" : "New folder") + " — Czar" %>
<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Documents", docs_path %> <span class="sep">/</span> <%= link_to "Folders", folders_path %> <span class="sep">/</span> <span><%= @folder.persisted? ? "Edit" : "New" %></span></nav>
<div class="saas-form-wrap narrow">
  <h1><%= @folder.persisted? ? "Edit folder" : "New folder" %></h1>
  <p class="muted">Folders only organize — docs are the primary unit.</p>
  <%= form_with model: @folder do |f| %>
    <%= render "shared/form_errors", record: @folder %>
    <div class="saas-field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, required: true %>
    </div>
    <div class="saas-field">
      <%= f.label :parent_id, "Inside" %>
      <%= f.select :parent_id, options_for_select([["Root", ""]] + @folders.map { |x| [x.name, x.id] }, @folder.parent_id) %>
    </div>
    <div class="saas-form-actions">
      <%= f.submit @folder.persisted? ? "Save" : "Create", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", @folder.persisted? ? @folder : folders_path, class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
