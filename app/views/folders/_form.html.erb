<% content_for :title, (@folder.persisted? ? "Edit folder" : "New folder") + " — Czar" %>
<div class="saas-crumb"><%= link_to "Documents", docs_path %> <span class="sep">/</span> <%= link_to "Folders", folders_path %> <span class="sep">/</span> <span><%= @folder.persisted? ? "Edit" : "New" %></span></div>
<div class="saas-form-wrap" style="max-width:560px">
  <span class="saas-section-label">Docs · Organization (secondary)</span>
  <h1><%= @folder.persisted? ? "Edit folder" : "New folder" %></h1>
  <p class="muted">Folders only organize — docs are the primary unit.</p>
  <%= form_with model: @folder do |f| %>
    <% if @folder.errors.any? %>
      <div class="saas-errors"><ul style="margin:0;padding-left:18px"><% @folder.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
    <% end %>
    <div class="saas-field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, required: true, style: "width:100%;border:1px solid var(--sz-line);border-radius:10px;padding:11px 12px;font-size:14px" %>
    </div>
    <div class="saas-field">
      <%= f.label :parent_id, "Inside" %>
      <%= f.select :parent_id, options_for_select([["Root", ""]] + @folders.map { |x| [x.name, x.id] }, @folder.parent_id) %>
    </div>
    <div class="saas-form-actions">
      <%= f.submit @folder.persisted? ? "Save" : "Create", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", @folder.persisted? ? @folder : folders_path, class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
