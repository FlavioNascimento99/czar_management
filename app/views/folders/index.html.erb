<% content_for :title, "Minhas Pastas" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Pastas</h1>
  <%= link_to "Nova Pasta", new_folder_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @folders.any? %>
  <div class="list-group mb-4">
    <% @folders.each do |folder| %>
      <div class="list-group-item d-flex justify-content-between align-items-center">
        <%= link_to folder, class: "text-decoration-none" do %>
          <strong>📁 <%= folder.name %></strong>
          <small class="text-muted d-block"><%= folder.subfolders.size %> subpastas · <%= folder.docs.count %> docs</small>
        <% end %>
        <span class="d-flex gap-2">
          <%= link_to "Editar", edit_folder_path(folder), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Excluir", folder, data: { turbo_method: :delete, turbo_confirm: "Excluir pasta e subpastas?" }, class: "btn btn-sm btn-outline-danger" %>
        </span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">Nenhuma pasta. Organize seus docs por assunto! 📁</p>
<% end %>

<% if @loose_docs.any? %>
  <h5>Sem pasta</h5>
  <div class="list-group">
    <% @loose_docs.each do |doc| %>
      <%= link_to doc, class: "list-group-item list-group-item-action" do %>
        <%= doc.title %>
      <% end %>
    <% end %>
  </div>
<% end %>
