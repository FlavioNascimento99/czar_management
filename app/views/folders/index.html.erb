<% content_for :title, "Folders — Czar" %>

<div class="saas-crumb"><%= link_to "Documents", docs_path %> <span class="sep">/</span> <span>Folders</span></div>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Docs · Organization (secondary)</span>
    <h1>Folders</h1>
    <p>Secondary management for your primary docs. Create docs first, organize after.</p>
  </div>
  <div style="display:flex;gap:8px">
    <%= link_to "＋ New doc", new_doc_path, class: "saas-btn saas-btn-primary" %>
    <%= link_to "New folder", new_folder_path, class: "saas-btn saas-btn-ghost" %>
  </div>
</div>

<% if @folders.any? %>
  <div class="saas-list" style="margin-bottom:16px">
    <% @folders.each do |folder| %>
      <div class="saas-list-item">
        <%= link_to folder, style: "color:inherit" do %>
          <span><strong>📁 <%= folder.name %></strong><small class="saas-mini" style="display:block"><%= folder.subfolders.size %> subfolders · <%= folder.docs.count %> docs</small></span>
        <% end %>
        <span style="display:flex;gap:8px">
          <%= link_to "Edit", edit_folder_path(folder), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
          <%= link_to "Delete", folder, data: { turbo_method: :delete, turbo_confirm: "Delete folder and subfolders?" }, class: "saas-btn saas-btn-ghost saas-btn-sm", style: "color:var(--sz-red)" %>
        </span>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="saas-panel"><div class="saas-empty"><p>No folders. Organize your docs by topic! 📁</p></div></div>
<% end %>

<% if @loose_docs.any? %>
  <div class="saas-panel">
    <h2>No folder</h2>
    <div class="saas-side-list">
      <% @loose_docs.each do |doc| %>
        <div class="saas-row"><%= link_to doc.title, doc %></div>
      <% end %>
    </div>
  </div>
<% end %>
