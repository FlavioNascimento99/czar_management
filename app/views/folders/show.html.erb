<% content_for :title, @folder.name %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Pastas", folders_path %></li>
    <% @folder.breadcrumb.each do |crumb| %>
      <li class="breadcrumb-item"><%= link_to crumb.name, crumb %></li>
    <% end %>
    <li class="breadcrumb-item active"><%= @folder.name %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>📁 <%= @folder.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Nova Subpasta", new_folder_path(parent_id: @folder.id), class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Novo Doc aqui", new_doc_path(folder_id: @folder.id), class: "btn btn-primary btn-sm" %>
  </div>
</div>

<% if @subfolders.any? %>
  <div class="list-group mb-3">
    <% @subfolders.each do |sub| %>
      <%= link_to sub, class: "list-group-item list-group-item-action" do %>
        📁 <%= sub.name %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @docs.any? %>
  <div class="list-group">
    <% @docs.each do |doc| %>
      <%= link_to doc, class: "list-group-item list-group-item-action" do %>
        <%= doc.title %>
        <small class="text-muted d-block"><%= l(doc.updated_at, format: :short) %></small>
      <% end %>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center">
    <%= paginate @docs, theme: "bootstrap-5" %>
  </div>
<% else %>
  <p class="text-muted">Pasta vazia.</p>
<% end %>
