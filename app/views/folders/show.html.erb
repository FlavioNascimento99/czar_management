<% content_for :title, @folder.name %>

<div class="saas-crumb"><%= link_to "Documents", docs_path %> <span class="sep">/</span> <%= link_to "Folders", folders_path %> <span class="sep">/</span> <% @folder.breadcrumb.each do |crumb| %><%= link_to crumb.name, crumb %> <span class="sep">/</span> <% end %> <span><%= @folder.name %></span></div>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Docs · Folder</span>
    <h1>📁 <%= @folder.name %></h1>
    <p>Secondary organization — docs stay primary.</p>
  </div>
  <div style="display:flex;gap:8px">
    <%= link_to "New subfolder", new_folder_path(parent_id: @folder.id), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <%= link_to "＋ New doc here", new_doc_path(folder_id: @folder.id), class: "saas-btn saas-btn-primary saas-btn-sm" %>
  </div>
</div>

<% if @subfolders.any? %>
  <div class="saas-list" style="margin-bottom:16px">
    <% @subfolders.each do |sub| %>
      <%= link_to sub, class: "saas-list-item", style: "color:inherit" do %>
        <span><strong>📁 <%= sub.name %></strong></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @docs.any? %>
  <div class="saas-list">
    <% @docs.each do |doc| %>
      <%= link_to doc, class: "saas-list-item", style: "color:inherit" do %>
        <span><strong><%= doc.title %></strong><small class="saas-mini" style="display:block"><%= l(doc.updated_at, format: :short) %></small></span>
      <% end %>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center"><%= paginate @docs, theme: "bootstrap-5" %></div>
<% else %>
  <div class="saas-panel"><div class="saas-empty"><p>Empty folder.</p><%= link_to "Create doc here", new_doc_path(folder_id: @folder.id), class: "saas-btn saas-btn-primary saas-btn-sm" %></div></div>
<% end %>
