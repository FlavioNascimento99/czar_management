<% content_for :title, @doc.title %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <small class="text-muted"><%= @doc.folder ? "#{@doc.folder.name} / " : "" %>atualizado <%= l(@doc.updated_at, format: :short) %></small>
    <h1><%= @doc.title %></h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Editar", edit_doc_path(@doc), class: "btn btn-primary btn-sm" %>
    <%= link_to "Excluir", @doc, data: { turbo_method: :delete, turbo_confirm: "Excluir documento?" }, class: "btn btn-outline-danger btn-sm" %>
    <%= link_to "Voltar", docs_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div class="card shadow mb-4">
  <div class="card-body">
    <%= sanitize @doc.rendered_body %>
  </div>
</div>

<div class="card shadow">
  <div class="card-body">
    <h5>Anexos (<%= @doc.files.count %>)</h5>
    <% if @doc.files.attached? %>
      <div class="list-group list-group-flush">
        <% @doc.files.each do |file| %>
          <div class="list-group-item px-0 d-flex justify-content-between">
            <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "attachment") %>
            <%= link_to "Remover", purge_file_doc_path(@doc, file.id), data: { turbo_method: :delete, turbo_confirm: "Remover?" }, class: "btn btn-link btn-sm text-danger p-0" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted mb-0">Nenhum anexo.</p>
    <% end %>
  </div>
</div>
