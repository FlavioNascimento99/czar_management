<% content_for :title, @doc.title %>

<div class="saas-crumb"><%= link_to "Documents", docs_path %> <span class="sep">/</span> <span><%= @doc.folder ? @doc.folder.name : "No folder" %></span> <span class="sep">/</span> <span><%= truncate(@doc.title, length: 40) %></span></div>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Docs · Updated <%= l(@doc.updated_at, format: :short) %></span>
    <h1><%= @doc.title %></h1>
    <p><%= @doc.folder ? "In #{@doc.folder.name}" : "No folder — organize later in Folders" %></p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <%= link_to "Edit", edit_doc_path(@doc), class: "saas-btn saas-btn-primary saas-btn-sm" %>
    <%= link_to "Delete", @doc, data: { turbo_method: :delete, turbo_confirm: "Delete document?" }, class: "saas-btn saas-btn-ghost saas-btn-sm", style: "color:var(--sz-red);border-color:#fecaca" %>
    <%= link_to "Back", docs_path, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
  </div>
</div>

<div class="saas-detail">
  <div class="saas-detail-main">
    <div class="saas-panel">
      <div class="saas-doc-body"><%= sanitize @doc.rendered_body %></div>
    </div>
  </div>
  <div class="saas-detail-main">
    <% if @linked_tasks.any? %>
      <div class="saas-panel">
        <h2>Linked tasks</h2>
        <div class="saas-side-list">
          <% @linked_tasks.each do |task| %>
            <div class="saas-row"><%= link_to task.title, [task.project, task] %></div>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="saas-panel">
      <h2>Attachments · <%= @doc.files.count %></h2>
      <% if @doc.files.attached? %>
        <div class="saas-side-list">
          <% @doc.files.each do |file| %>
            <div class="saas-row">
              <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "attachment") %>
              <%= link_to "Remove", purge_file_doc_path(@doc, file.id), data: { turbo_method: :delete, turbo_confirm: "Remove?" }, class: "saas-btn saas-btn-ghost saas-btn-sm", style: "color:var(--sz-red)" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="saas-empty"><p>No attachments.</p></div>
      <% end %>
    </div>
  </div>
</div>
