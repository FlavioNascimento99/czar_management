<% content_for :title, "Meus Documentos" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Documentos</h1>
  <div class="d-flex gap-2">
    <%= link_to "Pastas", folders_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Novo Documento", new_doc_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<%= form_with url: docs_path, method: :get, local: true, class: "mb-3 d-flex gap-2" do %>
  <%= search_field_tag :q, params[:q], class: "form-control", placeholder: "Buscar em título e conteúdo..." %>
  <%= submit_tag "Buscar", class: "btn btn-outline-primary" %>
  <% if params[:q].present? %><%= link_to "Limpar", docs_path, class: "btn btn-outline-secondary" %><% end %>
<% end %>

<% if @docs.any? %>
  <div class="list-group">
    <% @docs.each do |doc| %>
      <%= link_to doc, class: "list-group-item list-group-item-action" do %>
        <strong><%= doc.title %></strong>
        <small class="text-muted d-block"><%= doc.folder&.name || "Sem pasta" %> · <%= l(doc.updated_at, format: :short) %></small>
      <% end %>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center">
    <%= paginate @docs, theme: "bootstrap-5" %>
  </div>
<% else %>
  <p class="text-muted">Nenhum documento. Comece escrevendo o primeiro! 📝</p>
<% end %>
