<% content_for :title, "Documents — Czar" %>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Docs · Primary workspace</span>
    <h1>Documents</h1>
    <p>Write first, organize in folders, link to tasks when ready to execute.</p>
  </div>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
    <%= link_to "Folders", folders_path, class: "saas-btn saas-btn-ghost" %>
    <%= link_to "＋ New document", new_doc_path, class: "saas-btn saas-btn-primary" %>
  </div>
</div>

<%= form_with url: docs_path, method: :get, local: true, class: "saas-search" do %>
  <%= search_field_tag :q, params[:q], placeholder: "Search title and content…" %>
  <%= submit_tag "Search", class: "saas-btn saas-btn-ghost" %>
  <% if params[:q].present? %><%= link_to "Clear", docs_path, class: "saas-btn saas-btn-ghost" %><% end %>
<% end %>

<% if @docs.any? %>
  <div class="saas-2col">
    <div class="saas-list">
      <% @docs.each do |doc| %>
        <%= link_to doc, class: "saas-list-item", style: "color:inherit" do %>
          <span><strong>📝 <%= doc.title %></strong><small class="saas-mini" style="display:block"><%= doc.folder&.name || "No folder" %> · <%= l(doc.updated_at, format: :short) %></small></span>
          <span class="saas-btn saas-btn-ghost saas-btn-sm">Open</span>
        <% end %>
      <% end %>
    </div>
    <div class="saas-panel">
      <h2>How docs work</h2>
      <p class="saas-mini">1. Create a doc (primary).<br>2. Organize in folders (secondary).<br>3. Link docs to tasks in Projects → Task → Linked documents.</p>
      <hr class="saas-divider">
      <%= link_to "＋ New document", new_doc_path, class: "saas-btn saas-btn-primary saas-btn-sm" %>
      <%= link_to "Manage folders", folders_path, class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    </div>
  </div>
  <div class="mt-3 d-flex justify-content-center"><%= paginate @docs, theme: "bootstrap-5" %></div>
<% else %>
  <div class="saas-panel"><div class="saas-empty">
    <p><strong>No documents yet.</strong><br>Start with your first note — it takes 10 seconds. 📝</p>
    <%= link_to "Create document", new_doc_path, class: "saas-btn saas-btn-primary saas-btn-sm" %>
  </div></div>
<% end %>
