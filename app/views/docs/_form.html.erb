<div class="saas-form-wrap wide">
  <h1><%= @doc.persisted? ? "Edit document" : "New document" %></h1>
  <p class="muted">Markdown with live preview. Folder organization is secondary — write first.</p>
  <%= form_with model: @doc, html: { multipart: true } do |f| %>
    <%= render "shared/form_errors", record: @doc %>
    <div class="saas-field-row two">
      <div class="saas-field">
        <%= f.label :title, "Title" %>
        <%= f.text_field :title, required: true, placeholder: "Ex: Study roadmap — Week 1" %>
      </div>
      <div class="saas-field">
        <%= f.label :folder_id, "Folder (secondary)" %>
        <%= f.select :folder_id, options_for_select([["No folder", ""]] + @folders.map { |x| [x.name, x.id] }, @doc.folder_id) %>
      </div>
    </div>
    <div data-controller="markdown" data-markdown-url-value="<%= preview_docs_path %>">
      <div class="saas-field-row two">
        <div class="saas-field">
          <%= f.label :body, "Markdown" %>
          <%= f.text_area :body, rows: 18, class: "saas-mono", data: { markdown_target: "input", action: "input->markdown#changed" } %>
        </div>
        <div class="saas-field">
          <span class="saas-label" id="doc_preview_label">Preview</span>
          <div class="saas-md-preview saas-doc-body" role="region" aria-labelledby="doc_preview_label" data-markdown-target="preview"><em class="saas-mini">Loading preview…</em></div>
        </div>
      </div>
    </div>
    <div class="saas-field">
      <%= f.label :files, "Attachments" %>
      <%= f.file_field :files, multiple: true %>
    </div>
    <div class="saas-form-actions">
      <%= f.submit @doc.persisted? ? "Save changes" : "Create document", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", @doc.persisted? ? @doc : docs_path, class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
