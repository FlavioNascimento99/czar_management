<% content_for :title, "Novo Documento" %>
<div class="row justify-content-center">
  <div class="col-md-10">
    <div class="card shadow">
      <div class="card-body">
        <h3>Novo Documento</h3>
        <%= form_with model: @doc, html: { multipart: true } do |f| %>
          <% if @doc.errors.any? %>
            <div class="alert alert-danger"><ul class="mb-0"><% @doc.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
          <% end %>
          <div class="row g-2 mb-2">
            <div class="col-md-8">
              <%= f.label :title, "Título", class: "form-label" %>
              <%= f.text_field :title, class: "form-control", required: true, placeholder: "Ex: Roteiro de estudos — Semana 1" %>
            </div>
            <div class="col-md-4">
              <%= f.label :folder_id, "Pasta", class: "form-label" %>
              <%= f.select :folder_id, options_for_select([["Sem pasta", ""]] + @folders.map { |x| [x.name, x.id] }, @doc.folder_id), {}, class: "form-select" %>
            </div>
          </div>
          <div data-controller="markdown" data-markdown-url-value="<%= preview_docs_path %>">
            <div class="row">
              <div class="col-md-6">
                <%= f.label :body, "Markdown", class: "form-label" %>
                <%= f.text_area :body, rows: 18, class: "form-control font-monospace", data: { markdown_target: "input", action: "input->markdown#changed" } %>
              </div>
              <div class="col-md-6">
                <span class="form-label">Preview</span>
                <div class="border rounded p-3 h-100" data-markdown-target="preview"><em class="text-muted">Carregando preview...</em></div>
              </div>
            </div>
          </div>
          <div class="mt-2">
            <%= f.label :files, "Anexos", class: "form-label" %>
            <%= f.file_field :files, multiple: true, class: "form-control" %>
          </div>
          <div class="d-flex gap-2 mt-3">
            <%= f.submit "Criar", class: "btn btn-primary" %>
            <%= link_to "Cancelar", docs_path, class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
