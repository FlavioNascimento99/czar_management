<section class="saas-panel">
  <div class="saas-task-head">
    <h1><%= @task.title %></h1>
    <%= priority_badge(@task.priority) %>
  </div>
  <div class="saas-badges saas-meta-line">
    <%= status_badge(@task.status) %>
    <%= due_date_badge(@task) %>
    <% unless @task.nenhuma? %>
      <span class="saas-badge gray"><%= icon("repeat", size: 14) %><%= @task.diaria? ? "Daily" : "Weekly" %></span>
    <% end %>
    <% @task.tags.each do |tag| %><%= tag_badge(tag) %><% end %>
  </div>
  <hr class="saas-divider">
  <div class="saas-prose-sm"><%= simple_format(@task.description) %></div>
  <div class="saas-meta-line">
    <span>Author: <strong><%= @task.author.name %></strong></span>
    <span>Owner: <strong><%= @task.assigned_to.name %></strong></span>
  </div>
  <div class="saas-actions-row">
    <%= link_to edit_project_task_path(@project, @task), class: "saas-btn saas-btn-primary saas-btn-sm" do %>
      <%= icon("pencil") %><span>Edit</span>
    <% end %>
    <%= link_to [@project, @task],
                data: { turbo_method: :delete, turbo_confirm: "Delete this task?" },
                class: "saas-btn saas-btn-danger-soft saas-btn-sm" do %>
      <%= icon("trash") %><span>Delete</span>
    <% end %>
    <%= link_to @project, class: "saas-btn saas-btn-ghost saas-btn-sm" do %>
      <%= icon("arrow-left") %><span>Back</span>
    <% end %>
  </div>
</section>
