<% content_for :title, "#{@task.title} — #{@project.name}" %>

<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span><%= truncate(@task.title, length: 40) %></span></nav>

<div class="saas-detail">
  <div class="saas-detail-main">
    <%= render "header" %>
    <%= render "checklist" %>
    <%= render "comments" %>
  </div>
  <aside class="saas-detail-main">
    <%= render "docs_attachments" %>
  </aside>
</div>
