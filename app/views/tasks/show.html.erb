<% content_for :title, "#{@task.title} - #{@project.name}" %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h3 class="card-title mb-0"><%= @task.title %></h3>
          <span class="badge bg-<%= @task.priority == "alta" ? "danger" : @task.priority == "media" ? "warning" : "secondary" %>">
            <%= @task.priority.capitalize %>
          </span>
        </div>

        <span class="badge bg-<%= @task.status == "concluida" ? "success" : @task.status == "em_andamento" ? "warning" : "secondary" %> mb-3">
          <%= @task.status.humanize %>
        </span>
        <%= due_date_badge(@task) %>
        <% unless @task.nenhuma? %>
          <span class="badge bg-dark">🔁 <%= @task.diaria? ? "Todo dia" : "Toda semana" %></span>
        <% end %>
        <% @task.tags.each do |tag| %>
          <span class="badge" style="background-color: <%= tag.color %>"><%= tag.name %></span>
        <% end %>

        <p class="mt-2"><%= simple_format(@task.description) %></p>

        <div class="small text-muted mb-3">
          <div>Autor: <%= @task.author.name %></div>
          <div>Responsável: <%= @task.assigned_to.name %></div>
        </div>

        <div class="d-flex gap-2">
          <%= link_to "Editar", edit_project_task_path(@project, @task), class: "btn btn-primary btn-sm" %>
          <%= link_to "Excluir", [ @project, @task ],
                      data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta tarefa?" },
                      class: "btn btn-outline-danger btn-sm" %>
          <%= link_to "Voltar", @project, class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="card shadow mt-4">
      <div class="card-body">
        <h5 class="card-title">Documentos vinculados (<%= @task_docs.size %>)</h5>
        <% if @task_docs.any? %>
          <div class="list-group list-group-flush mb-2">
            <% @task_docs.each do |link| %>
              <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                <%= link_to link.doc.title, link.doc %>
                <%= link_to "Desvincular", project_task_task_doc_path(@project, @task, link),
                            data: { turbo_method: :delete, turbo_confirm: "Remover vínculo?" },
                            class: "btn btn-link btn-sm text-danger p-0" %>
              </div>
            <% end %>
          </div>
        <% end %>
        <% if @available_docs.any? %>
          <%= form_with url: project_task_task_docs_path(@project, @task), method: :post, local: true, class: "d-flex gap-2" do %>
            <%= select_tag :doc_id, options_from_collection_for_select(@available_docs, :id, :title), class: "form-select form-select-sm" %>
            <%= submit_tag "Vincular", class: "btn btn-outline-primary btn-sm" %>
          <% end %>
        <% elsif @task_docs.empty? %>
          <p class="text-muted mb-0">Nenhum documento vinculado. Crie um em <%= link_to "Docs", docs_path %> e vincule aqui.</p>
        <% end %>
      </div>
    </div>

    <div class="card shadow mt-4" id="subtasks">
      <div class="card-body">
        <h5 class="card-title">Checklist (<%= @subtasks.count(&:done) %>/<%= @subtasks.size %>)</h5>
        <div class="progress mb-3" style="height: 8px">
          <div class="progress-bar" style="width: <%= @task.subtasks_progress %>%"></div>
        </div>
        <% if @subtasks.any? %>
          <div class="list-group list-group-flush mb-3">
            <% @subtasks.each do |subtask| %>
              <div class="list-group-item px-0 d-flex justify-content-between align-items-center" id="subtask_<%= subtask.id %>">
                <span class="<%= 'text-decoration-line-through text-muted' if subtask.done %>"><%= subtask.title %></span>
                <span class="d-flex gap-2">
                  <%= button_to subtask.done ? "Reabrir" : "Concluir", toggle_project_task_subtask_path(@project, @task, subtask),
                                method: :patch, class: "btn btn-sm btn-outline-success" %>
                  <%= link_to "Remover", project_task_subtask_path(@project, @task, subtask),
                              data: { turbo_method: :delete, turbo_confirm: "Remover subtarefa?" },
                              class: "btn btn-link btn-sm text-danger p-0" %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">Nenhuma subtarefa. Quebre o trabalho em passos!</p>
        <% end %>
        <%= form_with model: [@project, @task, @subtask] do |f| %>
          <div class="input-group">
            <%= f.text_field :title, class: "form-control", placeholder: "Nova subtarefa..." %>
            <%= f.submit "Adicionar", class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card shadow mt-4">
      <div class="card-body">
        <h5 class="card-title">Anexos (<%= @task.files.count %>)</h5>
        <% if @task.files.attached? %>
          <div class="list-group list-group-flush mb-2">
            <% @task.files.each do |file| %>
              <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "attachment") %>
                <span class="d-flex gap-2 align-items-center">
                  <small class="text-muted"><%= number_to_human_size(file.byte_size) %></small>
                  <%= link_to "Remover", purge_file_project_task_path(@project, @task, file.id),
                              data: { turbo_method: :delete, turbo_confirm: "Remover anexo?" },
                              class: "btn btn-link btn-sm text-danger p-0" %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">Nenhum anexo.</p>
        <% end %>
      </div>
    </div>
      </div>
    </div>

    <div class="card shadow mt-4">
      <div class="card-body">
        <h5 class="card-title">Comentários (<%= @comments.size %>)</h5>

        <% if @comments.any? %>
          <div class="list-group list-group-flush mb-3">
            <% @comments.each do |comment| %>
              <div class="list-group-item px-0">
                <div class="d-flex justify-content-between">
                  <strong><%= comment.author.name %></strong>
                  <small class="text-muted"><%= l(comment.created_at, format: :short) %></small>
                </div>
                <p class="mb-1"><%= simple_format(comment.body) %></p>
                <% if comment.author == current_user || @project.owned_by?(current_user) %>
                  <%= link_to "Excluir", project_task_comment_path(@project, @task, comment),
                              data: { turbo_method: :delete, turbo_confirm: "Excluir comentário?" },
                              class: "btn btn-link btn-sm text-danger p-0" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">Nenhum comentário ainda. Seja o primeiro!</p>
        <% end %>

        <%= form_with model: [@project, @task, @comment] do |f| %>
          <div class="mb-2">
            <%= f.text_area :body, rows: 3, class: "form-control", placeholder: "Escreva um comentário..." %>
          </div>
          <%= f.submit "Comentar", class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </div>
      </div>
    </div>
  </div>
</div>
