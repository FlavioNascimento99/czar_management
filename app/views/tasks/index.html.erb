<% content_for :title, "Tasks — #{@project.name}" %>

<div class="saas-crumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Tasks</span></div>

<div class="saas-page-head">
  <div>
    <span class="saas-section-label">Manage · Tasks</span>
    <h1>Tasks</h1>
    <p><%= @project.name %></p>
  </div>
  <%= link_to "＋ New task", new_project_task_path(@project), class: "saas-btn saas-btn-primary" %>
</div>

<%= form_with url: project_tasks_path(@project), method: :get, local: true, class: "saas-filters" do %>
  <%= search_field_tag :q, params[:q], placeholder: "Search title/description…", style: "flex:1;min-width:180px" %>
  <%= select_tag :status, options_for_select([["All statuses", ""]] + Task.statuses.keys.map { |s| [s.humanize, s] }, params[:status]) %>
  <%= select_tag :priority, options_for_select([["All priorities", ""]] + Task.priorities.keys.map { |p| [p.capitalize, p] }, params[:priority]) %>
  <%= select_tag :assigned_to_id, options_for_select([["All owners", ""]] + @project_users.map { |u| [u.name, u.id] }, params[:assigned_to_id]) %>
  <%= select_tag :tag_id, options_for_select([["All tags", ""]] + @project_tags.map { |t| [t.name, t.id] }, params[:tag_id]) %>
  <%= submit_tag "Filter", class: "saas-btn saas-btn-primary saas-btn-sm" %>
  <%= link_to "Clear", project_tasks_path(@project), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
<% end %>

<% if @tasks.any? %>
  <div class="saas-list">
    <% @tasks.each do |task| %>
      <%= link_to [@project, task], class: "saas-list-item", style: "color:inherit" do %>
        <span>
          <strong><%= task.title %></strong>
          <span class="saas-badges" style="margin-top:4px">
            <% task.tags.each do |tag| %><span class="saas-badge gray" style="background-color:<%= tag.color %>;color:#fff"><%= tag.name %></span><% end %>
          </span>
        </span>
        <span class="saas-badges"><%= due_date_badge(task) %><span class="saas-badge <%= task.status == 'concluida' ? 'green' : task.status == 'em_andamento' ? 'amber' : 'gray' %>"><%= task.status.humanize %></span></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="saas-panel"><div class="saas-empty"><p>No tasks found.</p></div></div>
<% end %>

<div class="mt-3 d-flex justify-content-center"><%= paginate @tasks, theme: "bootstrap-5" %></div>
<div style="margin-top:12px"><%= link_to "Back to project", @project, class: "saas-btn saas-btn-ghost saas-btn-sm" %></div>
