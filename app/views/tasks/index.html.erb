<% content_for :title, "Tasks — #{@project.name}" %>

<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Tasks</span></nav>

<div class="saas-page-head">
  <div>
    <h1>Tasks</h1>
    <p><%= @project.name %></p>
  </div>
  <%= link_to new_project_task_path(@project), class: "saas-btn saas-btn-primary" do %>
    <%= icon("plus") %><span>New task</span>
  <% end %>
</div>

<%= form_with url: project_tasks_path(@project), method: :get, local: true, class: "saas-filters", role: "search" do %>
  <%= search_field_tag :q, params[:q], placeholder: "Search title/description…", aria: { label: "Search tasks" } %>
  <%= select_tag :status, options_for_select([["All statuses", ""]] + Task.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), aria: { label: "Status" } %>
  <%= select_tag :priority, options_for_select([["All priorities", ""]] + Task.priorities.keys.map { |p| [p.capitalize, p] }, params[:priority]), aria: { label: "Priority" } %>
  <%= select_tag :assigned_to_id, options_for_select([["All owners", ""]] + @project_users.map { |u| [u.name, u.id] }, params[:assigned_to_id]), aria: { label: "Owner" } %>
  <%= select_tag :tag_id, options_for_select([["All tags", ""]] + @project_tags.map { |t| [t.name, t.id] }, params[:tag_id]), aria: { label: "Tag" } %>
  <%= submit_tag "Filter", class: "saas-btn saas-btn-primary saas-btn-sm" %>
  <%= link_to "Clear", project_tasks_path(@project), class: "saas-btn saas-btn-subtle saas-btn-sm" %>
<% end %>

<% if @tasks.any? %>
  <div class="saas-list">
    <% @tasks.each do |task| %>
      <%= link_to [@project, task], class: "saas-list-item" do %>
        <span class="saas-list-main">
          <span class="saas-list-title"><%= task.title %></span>
          <% if task.tags.any? %>
            <span class="saas-badges"><% task.tags.each do |tag| %><%= tag_badge(tag) %><% end %></span>
          <% end %>
        </span>
        <span class="saas-badges"><%= due_date_badge(task) %><%= status_badge(task.status) %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="saas-panel">
    <%= empty_state(icon_name: "search", title: "No tasks found",
                    text: "Try a different search or clear the filters to see every task in this project.") do %>
      <%= link_to "Clear filters", project_tasks_path(@project), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
    <% end %>
  </div>
<% end %>

<div class="saas-pager"><%= paginate @tasks, theme: "bootstrap-5" %></div>
<div class="saas-actions-row">
  <%= link_to @project, class: "saas-btn saas-btn-ghost saas-btn-sm" do %>
    <%= icon("arrow-left") %><span>Back to project</span>
  <% end %>
</div>
