<% content_for :title, "Tarefas - #{@project.name}" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Tarefas</h1>
    <small class="text-muted">Projeto: <%= @project.name %></small>
  </div>
  <%= link_to "Nova Tarefa", new_project_task_path(@project), class: "btn btn-primary" %>
</div>

<% if @tasks.any? %>
  <div class="list-group">
    <% @tasks.each do |task| %>
      <%= link_to [@project, task], class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
        <span><%= task.title %></span>
        <span class="badge bg-<%= task.status == "concluida" ? "success" : task.status == "em_andamento" ? "warning" : "secondary" %>">
          <%= task.status.humanize %>
        </span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">Nenhuma tarefa criada ainda.</p>
<% end %>

<div class="mt-3">
  <%= link_to "Voltar ao projeto", @project, class: "btn btn-secondary" %>
</div>
