<section class="saas-panel">
  <h2>Comments <span class="saas-muted"><%= @comments.size %></span></h2>
  <% if @comments.any? %>
    <div class="saas-side-list">
      <% @comments.each do |comment| %>
        <article class="saas-comment">
          <div class="saas-comment-head">
            <strong><%= comment.author.name %></strong>
            <small class="saas-mini"><%= l(comment.created_at, format: :short) %></small>
          </div>
          <div class="saas-comment-body"><%= simple_format(comment.body) %></div>
          <% if comment.author == current_user || @project.owned_by?(current_user) %>
            <%= link_to "Delete", project_task_comment_path(@project, @task, comment),
                        data: { turbo_method: :delete, turbo_confirm: "Delete comment?" },
                        class: "saas-btn saas-btn-danger-soft saas-btn-sm" %>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(icon_name: "message-square", title: "No comments yet",
                    text: "Share progress or ask a question. The task owner gets notified.") %>
  <% end %>
  <%= form_with model: [@project, @task, @comment], class: "saas-comment-form" do |f| %>
    <div class="saas-field">
      <%= f.label :body, "Write a comment", class: "saas-sr-only" %>
      <%= f.text_area :body, rows: 3, placeholder: "Write a comment…" %>
    </div>
    <%= f.submit "Comment", class: "saas-btn saas-btn-primary saas-btn-sm" %>
  <% end %>
</section>
