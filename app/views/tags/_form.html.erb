<% content_for :title, (@tag.persisted? ? "Edit tag" : "New tag") + " — Czar" %>
<div class="saas-crumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Tag</span></div>
<div class="saas-form-wrap" style="max-width:560px">
  <span class="saas-section-label">Manage · Tag</span>
  <h1><%= @tag.persisted? ? "Edit tag" : "New tag" %></h1>
  <p class="muted">Project: <%= @project.name %></p>
  <%= form_with model: [@project, @tag] do |f| %>
    <% if @tag.errors.any? %>
      <div class="saas-errors"><ul style="margin:0;padding-left:18px"><% @tag.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
    <% end %>
    <div class="saas-field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: frontend", style: "width:100%;border:1px solid var(--sz-line);border-radius:10px;padding:11px 12px;font-size:14px" %>
    </div>
    <div class="saas-field">
      <%= f.label :color, "Color" %>
      <%= f.color_field :color, style: "width:64px;height:40px;border:1px solid var(--sz-line);border-radius:10px;padding:4px" %>
    </div>
    <div class="saas-form-actions">
      <%= f.submit @tag.persisted? ? "Save" : "Create", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", project_tags_path(@project), class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
