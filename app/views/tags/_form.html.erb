<% content_for :title, (@tag.persisted? ? "Edit tag" : "New tag") + " — Czar" %>
<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <%= link_to "Tags", project_tags_path(@project) %> <span class="sep">/</span> <span><%= @tag.persisted? ? "Edit" : "New" %></span></nav>
<div class="saas-form-wrap narrow">
  <h1><%= @tag.persisted? ? "Edit tag" : "New tag" %></h1>
  <p class="muted">Project: <%= @project.name %></p>
  <%= form_with model: [@project, @tag] do |f| %>
    <%= render "shared/form_errors", record: @tag %>
    <div class="saas-field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: frontend" %>
    </div>
    <div class="saas-field">
      <%= f.label :color, "Color" %>
      <%= f.color_field :color %>
    </div>
    <div class="saas-form-actions">
      <%= f.submit @tag.persisted? ? "Save" : "Create", class: "saas-btn saas-btn-primary" %>
      <%= link_to "Cancel", project_tags_path(@project), class: "saas-btn saas-btn-ghost" %>
    </div>
  <% end %>
</div>
