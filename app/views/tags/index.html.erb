<% content_for :title, "Tags — #{@project.name}" %>
<div class="saas-crumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Tags</span></div>
<div class="saas-page-head">
  <div><span class="saas-section-label">Manage · Tags</span><h1>Tags</h1><p><%= @project.name %></p></div>
  <%= link_to "＋ New tag", new_project_tag_path(@project), class: "saas-btn saas-btn-primary" %>
</div>
<% if @tags.any? %>
  <div class="saas-list">
    <% @tags.each do |tag| %>
      <div class="saas-list-item">
        <span><span class="saas-badge gray" style="background-color:<%= tag.color %>;color:#fff">&nbsp;</span> <strong><%= tag.name %></strong> <small class="saas-mini">(<%= tag.tasks.count %>)</small></span>
        <span style="display:flex;gap:8px">
          <%= link_to "Edit", edit_project_tag_path(@project, tag), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
          <%= link_to "Delete", project_tag_path(@project, tag), data: { turbo_method: :delete, turbo_confirm: "Delete tag?" }, class: "saas-btn saas-btn-ghost saas-btn-sm", style: "color:var(--sz-red)" %>
        </span>
      </div>
    <% end %>
  </div>
  <div class="mt-3 d-flex justify-content-center"><%= paginate @tags, theme: "bootstrap-5" %></div>
<% else %>
  <div class="saas-panel"><div class="saas-empty"><p>No tags yet.</p></div></div>
<% end %>
<div style="margin-top:12px"><%= link_to "Back to project", @project, class: "saas-btn saas-btn-ghost saas-btn-sm" %></div>
