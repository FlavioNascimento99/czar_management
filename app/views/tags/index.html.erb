<% content_for :title, "Tags — #{@project.name}" %>
<nav class="saas-crumb" aria-label="Breadcrumb"><%= link_to "Projects", projects_path %> <span class="sep">/</span> <%= link_to @project.name, @project %> <span class="sep">/</span> <span>Tags</span></nav>
<div class="saas-page-head">
  <div><h1>Tags</h1><p><%= @project.name %></p></div>
  <%= link_to new_project_tag_path(@project), class: "saas-btn saas-btn-primary" do %>
    <%= icon("plus") %><span>New tag</span>
  <% end %>
</div>
<% if @tags.any? %>
  <div class="saas-list">
    <% @tags.each do |tag| %>
      <div class="saas-list-item">
        <span class="saas-list-title">
          <%= color_dot(tag.color, size: 10) %>
          <span><%= tag.name %></span>
          <span class="saas-badge gray"><%= pluralize(tag.tasks.count, "task") %></span>
        </span>
        <span class="saas-row-actions">
          <%= link_to "Edit", edit_project_tag_path(@project, tag), class: "saas-btn saas-btn-ghost saas-btn-sm" %>
          <%= link_to "Delete", project_tag_path(@project, tag), data: { turbo_method: :delete, turbo_confirm: "Delete tag?" }, class: "saas-btn saas-btn-danger-soft saas-btn-sm" %>
        </span>
      </div>
    <% end %>
  </div>
  <div class="saas-pager"><%= paginate @tags, theme: "bootstrap-5" %></div>
<% else %>
  <div class="saas-panel">
    <%= empty_state(icon_name: "tag", title: "No tags yet",
                    text: "Tags group tasks across statuses, like frontend or bug. Filter the task list by tag.") do %>
      <%= link_to "Create first tag", new_project_tag_path(@project), class: "saas-btn saas-btn-primary saas-btn-sm" %>
    <% end %>
  </div>
<% end %>
<div class="saas-actions-row">
  <%= link_to @project, class: "saas-btn saas-btn-ghost saas-btn-sm" do %>
    <%= icon("arrow-left") %><span>Back to project</span>
  <% end %>
</div>
